<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- SDK 31+: native SplashScreen API renders the adaptive icon in a circle,
       which is the intended design for modern Android. -->
  <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
    <item name="android:windowBackground">@drawable/legacy_window_background</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="windowSplashScreenBackground">#b6cff8</item>
    <!--
    <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    -->
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="windowSplashScreenIconBackgroundColor">#b6cff8</item>
    <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>
</resources>
